{
  "name": "grad-vscode",
  "displayName": "grad_vscode",
  "description": "Grad Project Management Tool",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "grad-explorer",
          "title": "Workflow",
          "icon": "$(organization)"
        }
      ]
    },
    "views": {
      "grad-explorer": [
        {
          "type": "webview",
          "id": "grad-login-view",
          "name": "Workflow",
          "when": "!grad:isLoggedIn" 
        },
        {
          "id": "grad-nodes-view",
          "name": "Workflow",
          "when": "grad:isLoggedIn",
          "icon": "$(organization)"
        }
      ]
    },
    "menus": {
        "view/title": [
            {
                "command": "grad-vscode.logout",
                "when": "view == grad-nodes-view",
                "group": "navigation@1" 
            },
            {
                "command": "grad-nodes-view.refreshEntry",
                "when": "view == grad-nodes-view",
                "group": "navigation@2"
            }
        ]
    },
    "commands": [
      { "command": "grad-vscode.login", "title": "Grad: Login" },
      { "command": "grad-vscode.logout", "title": "Grad: Logout", "icon": "$(sign-out)" },
      { "command": "grad-nodes-view.refreshEntry", "title": "Refresh", "icon": "$(refresh)" }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
